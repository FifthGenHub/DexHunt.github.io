			txt(G.dexBalance + ' $HUNT | \uD83D\uDD25' + G.totalBurned, W / 2, H * 0.065, '10px "Share Tech Mono"', C.gold, 0.6);
			const tabY = H * 0.095;
			ctx.fillStyle = G.shopTab === 'guns' ? 'rgba(0,255,255,0.15)' : 'rgba(30,30,50,0.5)';
			fRR(ctx, W * 0.05, tabY, W * 0.42, H * 0.035, 6);
			txt('GUNS (' + GUNS.length + ')', W * 0.26, tabY + H * 0.0175, 'bold 10px "Orbitron"', G.shopTab === 'guns' ? C.cyan : C.dim, 0.9);
			ctx.fillStyle = G.shopTab === 'reticles' ? 'rgba(255,0,255,0.15)' : 'rgba(30,30,50,0.5)';
			fRR(ctx, W * 0.53, tabY, W * 0.42, H * 0.035, 6);
			txt('RETICLES (' + RETICLES.length + ')', W * 0.74, tabY + H * 0.0175, 'bold 10px "Orbitron"', G.shopTab === 'reticles' ? C.magenta : C.dim, 0.9);
			const items = getShopItems(),
				owned = getOwnedList(),
				equipped = getEquipped();
			const listTop = H * 0.15,
				itemH = H * 0.088;
			for (let i = 0; i < items.length; i++) {
				const item = items[i],
					y = listTop + i * itemH;
				if (y + itemH > H * 0.93) break;
				const isOwned = owned.includes(item.id) || item.cost === 0,
					isEq = equipped === item.id,
					isSel = i === G.shopSelectedIdx;
				const rarCol = RARITY_COLORS[item.rarity] || C.dim;
				ctx.fillStyle = isSel ? 'rgba(0,255,255,0.06)' : 'rgba(20,20,40,0.4)';
				fRR(ctx, W * 0.03, y, W * 0.94, itemH - 3, 8);
				if (isEq) { ctx.strokeStyle = 'rgba(0,255,255,0.4)';
					ctx.lineWidth = 1;
					ctx.beginPath();
					rrP(ctx, W * 0.03, y, W * 0.94, itemH - 3, 8);
					ctx.stroke(); }
				if (G.shopTab === 'guns') drawProceduralGun(ctx, W * 0.15, y + itemH * 0.45, 0.8, item.id, 0.9, false);
				else drawReticle(ctx, W * 0.15, y + itemH * 0.45, item.id, 10, 0.9);
				txtL(item.name, W * 0.30, y + itemH * 0.28, 'bold 10px "Orbitron"', rarCol, 0.9);
				txtL('[' + item.rarity + ']', W * 0.30, y + itemH * 0.58, '8px "Share Tech Mono"', rarCol, 0.5);
				txtL(item.desc || '', W * 0.30, y + itemH * 0.82, '8px "Share Tech Mono"', C.dim, 0.35);
				const bX = W * 0.78,
					bY = y + itemH * 0.15,
					bW = W * 0.17,
					bH = itemH * 0.65;
				if (isEq) { ctx.fillStyle = 'rgba(0,255,255,0.1)';
					fRR(ctx, bX, bY, bW, bH, 5);
					txt('\u2713', bX + bW / 2, bY + bH / 2, 'bold 13px sans-serif', C.cyan, 0.8); } else if (isOwned) { ctx.fillStyle = 'rgba(0,255,136,0.1)';
					fRR(ctx, bX, bY, bW, bH, 5);
					txt('Equip', bX + bW / 2, bY + bH / 2, '8px "Share Tech Mono"', C.lime, 0.8); } else { ctx.fillStyle = 'rgba(255,215,0,0.1)';
					fRR(ctx, bX, bY, bW, bH, 5);
					txt(item.cost + ' $HUNT', bX + bW / 2, bY + bH * 0.35, 'bold 9px "Share Tech Mono"', C.gold, 0.9);
					txt('\uD83D\uDD25' + Math.floor(item.cost * BURN_RATE), bX + bW / 2, bY + bH * 0.7, '7px "Share Tech Mono"', C.orange, 0.6); }
			}
			// Burn disclaimer — positioned after last item with padding
			const disclaimerY = listTop + Math.min(items.length, 9) * itemH + 6;
			txt('\uD83D\uDD25 80% Burned | \uD83C\uDFC6 15% Vault | \uD83D\uDCC8 3% Liq | \u2705 2% Dev', W / 2, disclaimerY, '8px "Share Tech Mono"', C.orange, 0.35);
		}

