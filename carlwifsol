			fRR(ctx, bX, H * 0.62, bW, 4, 2);
			ctx.globalAlpha = 0.7;
			ctx.fillStyle = C.cyan;
			fRR(ctx, bX, H * 0.62, Math.max(2, bW * prog), 4, 2);
