		function getShopItems() { return G.shopTab === 'guns' ? GUNS : RETICLES; }

		function getOwnedList() { return G.shopTab === 'guns' ? G.ownedGuns : G.ownedReticles; }

		function getEquipped() { return G.shopTab === 'guns' ? G.equippedGun : G.equippedReticle; }

		function shopBuy(item) {
			// === SAFETY: Transaction validation ===
			// 1. Free items cannot be bought (already owned by default)
			if (item.cost === 0) return;
			const owned = getOwnedList();
			// 2. Prevent duplicate purchases — item already in owned list
			if (owned.includes(item.id)) return;
			// 3. Insufficient balance check
			if (G.dexBalance < item.cost) { showToast('Not enough $HUNT!'); return; }
			// === TOKENOMICS SPLIT (80/15/3/2) ===
			// 4. Calculate split: 80% burn, 15% vault, 3% liquidity, 2% dev (@CarlWifSOL)
			const burnAmt = Math.floor(item.cost * 0.80); // BURNED FOREVER - deflationary
			const vaultAmt = Math.floor(item.cost * 0.15); // REFLEX VAULT - prizes/community
			const liqAmt = Math.floor(item.cost * 0.03); // LIQUIDITY & MARKETING
			const devAmt = item.cost - burnAmt - vaultAmt - liqAmt; // DEV SUSTAINMENT (~2%) → @CarlWifSOL verified
			// 5. Deduct full cost from player balance
			G.dexBalance -= item.cost;
			// 6. Record burned amount (on-chain burn in future Anchor program)
			G.totalBurned += burnAmt;
			// 7. Grant item to player
			owned.push(item.id);
			if (G.shopTab === 'guns') G.equippedGun = item.id;
			else G.equippedReticle = item.id;
			sfxBuy();
			saveGame();
			spawnP(W / 2, H * 0.5, 25, C.goldRgb, { speed: [60, 200], life: [0.5, 1.0] });
			showToast('Bought ' + item.name + '! \uD83D\uDD25' + burnAmt + ' burned | \uD83C\uDFC6' + vaultAmt + ' vault');
			updateHud();
		}

		function shopEquip(item) {
			if (G.shopTab === 'guns') G.equippedGun = item.id;
			else G.equippedReticle = item.id;
			sfxSelect();
			showToast('Equipped ' + item.name);
		}

