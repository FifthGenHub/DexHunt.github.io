		// ================================================================
		// 6. PROCEDURAL RETICLE DRAWING (expanded to 9)
		// ================================================================
		function drawReticle(ctx, cx, cy, retId, size, alpha) {
			if (alpha < 0.01) return;
			const ret = RETICLES.find(r => r.id === retId) || RETICLES[0];

			// Asset-swap check
			if (ret.img) { const img = getAssetImg(ret.img); if (img) { ctx.save();
					ctx.globalAlpha = alpha; const s = size * 2;
					ctx.drawImage(img, cx - s, cy - s, s * 2, s * 2);
					ctx.restore(); return; } }

			ctx.save();
			ctx.globalAlpha = alpha;
			ctx.strokeStyle = ret.color;
			ctx.fillStyle = ret.color;
			ctx.lineWidth = 2;
			ctx.shadowColor = ret.color;
			ctx.shadowBlur = 8;
			const s = size;
			switch (retId) {
				case 'cross':
					ctx.beginPath();
					ctx.moveTo(cx - s, cy);
					ctx.lineTo(cx - s * .3, cy);
					ctx.moveTo(cx + s * .3, cy);
					ctx.lineTo(cx + s, cy);
					ctx.moveTo(cx, cy - s);
					ctx.lineTo(cx, cy - s * .3);
					ctx.moveTo(cx, cy + s * .3);
					ctx.lineTo(cx, cy + s);
					ctx.stroke();
					break;
				case 'diamond':
					ctx.beginPath();
					ctx.moveTo(cx, cy - s);
					ctx.lineTo(cx + s, cy);
					ctx.lineTo(cx, cy + s);
					ctx.lineTo(cx - s, cy);
					ctx.closePath();
					ctx.stroke();
					break;
				case 'ring':
					ctx.beginPath();
					ctx.arc(cx, cy, s, 0, Math.PI * 2);
					ctx.stroke();
					ctx.beginPath();
					ctx.arc(cx, cy, 2, 0, Math.PI * 2);
					ctx.fill();
					break;
				case 'skull':
					ctx.beginPath();
					ctx.moveTo(cx - s, cy - s);
					ctx.lineTo(cx + s, cy + s);
					ctx.moveTo(cx + s, cy - s);
					ctx.lineTo(cx - s, cy + s);
					ctx.stroke();
					break;
				case 'star':
					for (let i = 0; i < 5; i++) { const a = (i / 5) * Math.PI * 2 - Math.PI / 2;
						ctx.beginPath();
						ctx.moveTo(cx, cy);
						ctx.lineTo(cx + Math.cos(a) * s, cy + Math.sin(a) * s);
						ctx.stroke(); }
					break;
				case 'pulse':
					// Expanding concentric rings
					for (let i = 0; i < 3; i++) { const r = s * (0.3 + i * 0.35);
						ctx.globalAlpha = alpha * (1 - i * 0.3);
						ctx.beginPath();
						ctx.arc(cx, cy, r, 0, Math.PI * 2);
						ctx.stroke(); }
					ctx.globalAlpha = alpha;
					ctx.beginPath();
					ctx.arc(cx, cy, 2, 0, Math.PI * 2);
					ctx.fill();
					break;
				case 'vortex':
					// Spiral arms
					ctx.beginPath();
					for (let a = 0; a < Math.PI * 4; a += 0.1) { const r = s * 0.15 + s * 0.2 * (a / (Math.PI * 4));
						ctx.lineTo(cx + Math.cos(a) * r, cy + Math.sin(a) * r); } ctx.stroke();
					ctx.beginPath();
					for (let a = Math.PI; a < Math.PI * 5; a += 0.1) { const r = s * 0.15 + s * 0.2 * ((a - Math.PI) / (Math.PI * 4));
						ctx.lineTo(cx + Math.cos(a) * r, cy + Math.sin(a) * r); } ctx.stroke();
					break;
				case 'bolt':
					// Lightning bolt shape
					ctx.beginPath();
					ctx.moveTo(cx - 2, cy - s);
					ctx.lineTo(cx + 4, cy - 2);
					ctx.lineTo(cx - 1, cy);
					ctx.lineTo(cx + 5, cy + s);
					ctx.stroke();
					ctx.beginPath();
					ctx.arc(cx, cy, 2, 0, Math.PI * 2);
					ctx.fill();
					break;
				default:
					ctx.beginPath();
					ctx.arc(cx, cy, 3, 0, Math.PI * 2);
					ctx.fill();
			}
			ctx.restore();
		}

