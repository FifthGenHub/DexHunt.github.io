	<script>
		/* ================================================================
   DEXHUNT: REFLEX SHOWDOWN — v4.2
   Increment B: Lore fields, 9 matching reticles, Heat Meter,
   asset-swap architecture, continuous loop with Stop button.
   ================================================================ */

		// ================================================================
		// 1. CONSTANTS
		// ================================================================
		const COUNTDOWN_SECS = 3,
			DRAW_MIN_DELAY = 1.5,
			DRAW_MAX_DELAY = 4.0;
		const RESULT_DISPLAY_SEC = 3.5,
			TOO_SOON_PENALTY = 1.8;
		const WIN_THRESHOLD = 600,
			FAST_THRESHOLD = 200,
			GOOD_THRESHOLD = 350;
		const STREAK_NICE = 3,
			STREAK_HOT = 5,
			STREAK_LEGEND = 10;
		const MAX_PARTICLES = 80,
			CARD_W = 1080,
			CARD_H = 1920;
		const BURN_RATE = 0.80;

		// Heat Meter constants
		const HEAT_MAX = 100;
		const HEAT_GAIN_WIN = 15; // Heat gained per win
		const HEAT_GAIN_FAST = 30; // Bonus heat for Lightning/Quick
		const HEAT_GAIN_COMBO = 10; // Extra heat per combo hit
		const HEAT_DECAY_RATE = 8; // Heat lost per second when idle
		const HEAT_DECAY_LOSS = 20; // Heat lost on loss/too-soon

		// ================================================================
		// 2. COLORS
		// ================================================================
		const C = {
			bg: '#0a0a14',
			bgRgb: [10, 10, 20],
			cyan: '#00ffff',
			cyanRgb: [0, 255, 255],
			magenta: '#ff00ff',
			magRgb: [255, 0, 255],
			magentaRgb: [255, 0, 255],
			lime: '#00ff88',
			limeRgb: [0, 255, 136],
			gold: '#ffd700',
			goldRgb: [255, 215, 0],
			red: '#ff2626',
			redRgb: [255, 38, 38],
			orange: '#ff8c00',
			orangeRgb: [255, 140, 0],
			white: '#ffffff',
			whiteRgb: [255, 255, 255],
			dim: '#888899',
			dimRgb: [136, 136, 153],
			silver: '#c0c0c0',
			silverRgb: [192, 192, 192],
		};

		// ================================================================
		const GUN_IMAGES = {
			classic: 'data:image/jpeg;base64,',
			blaster: 'data:image/jpeg;base64,',
			chrome: 'data:image/jpeg;base64,',
			dusty: 'data:image/jpeg;base64,',
			golden: 'data:image/jpeg;base64,',
			hellfire: 'data:image/jpeg;base64,',
			plasma: 'data:image/jpeg;base64,',
			frost: 'data:image/jpeg;base64,',
			viper: 'data:image/jpeg;base64,',
		};

		// 3. ITEM REGISTRIES — Guns with lore, asset-swap ready
		//    Each gun has an optional `img` field. If set to a URL,
		//    the renderer will load and display that image instead of
		//    the procedural drawing. Set to null for procedural fallback.
		//    Grok can generate images and we drop URLs in here.
		// ================================================================

		const SHARE_BG_IMAGES = [
			"data:image/jpeg;base64,", // crystal_wastes
			"data:image/jpeg;base64,", // nebula_flora
			"data:image/jpeg;base64,", // crystal_city
			"data:image/jpeg;base64,", // dark_mountains
			"data:image/jpeg;base64,", // neon_cactus
			"data:image/jpeg;base64,", // cosmic_vortex
		];

		const GUNS = [{
				id: 'classic',
				name: 'Brown Classic',
				rarity: 'Common',
				cost: 0,
				color: '#8B6914',
				accent: '#A0783C',
				img: GUN_IMAGES.classic,
				desc: 'Standard issue. Gets the job done.',
				lore: 'The trusted revolver of frontier scouts, its circuit-engraved cylinder hums with stable cyan energy. Simple, reliable — it turns fair draws into legends.'
			},
			{
				id: 'blaster',
				name: 'Neon Blaster',
				rarity: 'Uncommon',
				cost: 50,
				color: '#00ccff',
				accent: '#0088ff',
				img: GUN_IMAGES.blaster,
				desc: 'Pulsing cyan energy weapon.',
				lore: 'Reverse-engineered from salvaged tech found in the Crystal Wastes. Its pulsing cyan core hums at 440Hz — the same frequency as a rattlesnake\'s warning.'
			},
			{
				id: 'chrome',
				name: 'Chrome .45',
				rarity: 'Uncommon',
				cost: 75,
				color: '#c0c0c0',
				accent: '#e8e8e8',
				img: GUN_IMAGES.chrome,
				desc: 'Mirror finish. Intimidation factor.',
				lore: 'Polished to a mirror shine by the gunsmiths of Silver Mesa. They say your opponent sees their own fear reflected in its barrel before the draw.'
			},
			{
				id: 'dusty',
				name: 'Dusty Six',
				rarity: 'Common',
				cost: 30,
				color: '#8B7355',
				accent: '#6B5335',
				img: GUN_IMAGES.dusty,
				desc: 'Worn but reliable frontier revolver.',
				lore: 'Found half-buried in the sands outside Copper Canyon. The serial number was filed off long ago. Whoever owned this before you didn\'t need it anymore.'
			},
			{
				id: 'golden',
				name: 'Golden Eagle',
				rarity: 'Rare',
				cost: 200,
				color: '#FFD700',
				accent: '#FFA500',
				img: GUN_IMAGES.golden,
				desc: '24k gold plated. Pure flex.',
				lore: 'Commissioned by the Solana Syndicate\'s inner circle. The 24k plating adds 47 grams of dead weight — but the psychological damage to your opponent is priceless.'
			},
			{
				id: 'hellfire',
				name: 'Hellfire',
				rarity: 'Legendary',
				cost: 500,
				color: '#ff2200',
				accent: '#ff6600',
				img: GUN_IMAGES.hellfire,
				desc: 'Forged in the neon underworld.',
				lore: 'Forged in the molten runoff beneath Neon Vegas. Its white-hot vents roar with contained fury — previous owners all share one thing: undefeated records.'
			},
			{
				id: 'plasma',
				name: 'Plasma Cannon',
				rarity: 'Rare',
				cost: 250,
				color: '#cc00ff',
				accent: '#8800cc',
				img: GUN_IMAGES.plasma,
				desc: 'Overcharged particle beam.',
				lore: 'A prototype that was never meant to leave the Quantum Arms lab. The overcharged cells give it a distinctive purple corona — and an unfortunate tendency to hum show tunes.'
			},
			{
				id: 'frost',
				name: 'Frost Bite',
				rarity: 'Uncommon',
				cost: 80,
				color: '#88ddff',
				accent: '#aaeeff',
				img: GUN_IMAGES.frost,
				desc: 'Sub-zero coolant rounds.',
				lore: 'Engineered in the cryo-forges of North Block, each round is cooled to -60°C before firing. The barrel frosts over between duels. Handle with thermal gloves.'
			},
			{
				id: 'viper',
				name: 'Scarlet Viper',
				rarity: 'Legendary',
				cost: 750,
				color: '#ff0044',
				accent: '#cc0033',
				img: GUN_IMAGES.viper,
				desc: 'The deadliest draw in the west.',
				lore: 'Only three exist. One belongs to the Marshal of Neon City. One was lost in the Great Burnout of \'24. This one chose you. The Viper doesn\'t miss — it decides.'
			},
		];

		const RETICLES = [{
				id: 'dot',
				name: 'Basic Dot',
				rarity: 'Common',
				cost: 0,
				color: C.lime,
				img: null,
				desc: 'Simple and effective.',
				lore: 'The default targeting pip. No frills, no distractions. Where the dot goes, the shot follows.'
			},
			{
				id: 'cross',
				name: 'Neon Cross',
				rarity: 'Common',
				cost: 25,
				color: C.cyan,
				img: null,
				desc: 'Classic crosshair.',
				lore: 'Standard-issue neon crosshair used by Frontier Deputies. The cyan glow is calibrated to remain visible against any background.'
			},
			{
				id: 'diamond',
				name: 'Diamond Sight',
				rarity: 'Uncommon',
				cost: 60,
				color: C.magenta,
				img: null,
				desc: 'Four-point precision.',
				lore: 'Designed by the optics division of Crystal Mesa Corp. The four-point geometry helps the brain calculate center faster than any circle.'
			},
			{
				id: 'ring',
				name: 'Holo Ring',
				rarity: 'Uncommon',
				cost: 80,
				color: C.cyan,
				img: null,
				desc: 'Holographic circle sight.',
				lore: 'Projects a floating holographic ring at the focal plane. Popular with speed-draw competitors for its intuitive "place the ring" targeting.'
			},
			{
				id: 'skull',
				name: 'Death Mark',
				rarity: 'Rare',
				cost: 150,
				color: C.red,
				img: null,
				desc: 'X marks the target.',
				lore: 'The calling card of the Crimson Riders. When this X appears on your screen, someone\'s streak is about to end.'
			},
			{
				id: 'star',
				name: 'Gold Star',
				rarity: 'Rare',
				cost: 200,
				color: C.gold,
				img: null,
				desc: 'Sheriff-grade targeting.',
				lore: 'Awarded only to those who earn the rank of Sheriff in the Neon Frontier. The five-point star is a badge of honor and a promise of accuracy.'
			},
			{
				id: 'pulse',
				name: 'Pulse Wave',
				rarity: 'Uncommon',
				cost: 70,
				color: C.lime,
				img: null,
				desc: 'Expanding ring pulse.',
				lore: 'A rippling concentric pulse that syncs with your heartbeat. The faster your heart races, the faster it pulses. Stay calm, draw fast.'
			},
			{
				id: 'vortex',
				name: 'Void Vortex',
				rarity: 'Rare',
				cost: 180,
				color: C.magenta,
				img: null,
				desc: 'Spinning void spiral.',
				lore: 'Borrowed from black-hole imaging tech. The spiral draws your eye to the exact center with gravitational precision.'
			},
			{
				id: 'bolt',
				name: 'Thunder Bolt',
				rarity: 'Legendary',
				cost: 350,
				color: C.gold,
				img: null,
				desc: 'Lightning-strike targeting.',
				lore: 'Reserved for those who\'ve achieved Lightning tier. The bolt crackles with static charge. When it strikes, the duel is already over.'
			},
		];

		const RARITY_COLORS = { Common: C.dim, Uncommon: C.lime, Rare: C.gold, Legendary: C.magenta };

		// ================================================================
		// 4. ASSET-SWAP ARCHITECTURE
		//    When `img` is set to a URL on any GUNS/RETICLES entry, the
		//    renderer loads that image and uses it instead of procedural.
		//    This lets Grok generate HD assets and we just paste URLs here.
		// ================================================================
		const AssetCache = {};

		function getAssetImg(url) {
			if (!url) return null;
			if (AssetCache[url]) return AssetCache[url].loaded ? AssetCache[url].img : null;
			const entry = { img: new Image(), loaded: false };
			entry.img.onload = () => { entry.loaded = true; };
			entry.img.onerror = () => { entry.loaded = false; };
			entry.img.crossOrigin = 'anonymous';
			entry.img.src = url;
			AssetCache[url] = entry;
			return null;
		}

		// ================================================================
		// 5. PROCEDURAL GUN DRAWING (unchanged from v4.1)
		// ================================================================
		function drawProceduralGun(ctx, cx, cy, scale, gunId, alpha, glow) {
			if (alpha < 0.01) return;
			const gun = GUNS.find(g => g.id === gunId) || GUNS[0];

			// Asset-swap check: if gun has an img URL and it's loaded, draw that instead
			// Uses center-crop + elliptical clip to remove background, standardize size
			if (gun.img) {
				const img = getAssetImg(gun.img);
				if (img) {
					ctx.save();
					ctx.globalAlpha = alpha;
					// Fixed render size: scale 1.0 = 70px wide
					const targetW = 70 * scale;
					const targetH = targetW * 0.55; // Consistent wide aspect for all guns
					// Center-crop source: take middle 60% to cut background edges
					const cropPct = 0.30; // 30% cropped from each edge pair
					const sx = img.width * cropPct * 0.7;
					const sy = img.height * cropPct;
					const sw = img.width * (1 - cropPct * 1.4);
					const sh = img.height * (1 - cropPct * 2);
					// Elliptical clip mask to soften edges (removes rectangular box look)
					ctx.beginPath();
					ctx.ellipse(cx, cy, targetW / 2 + 4, targetH / 2 + 4, 0, 0, Math.PI * 2);
					ctx.clip();
					if (glow) { ctx.shadowColor = gun.color;
						ctx.shadowBlur = 18; }
					ctx.drawImage(img, sx, sy, sw, sh, cx - targetW / 2, cy - targetH / 2, targetW, targetH);
					ctx.restore();
					return;
				}
			}

			ctx.save();
			ctx.globalAlpha = alpha;
			ctx.translate(cx, cy);
			ctx.scale(scale, scale);
			const col = gun.color,
				acc = gun.accent;
			if (glow) { ctx.shadowColor = col;
				ctx.shadowBlur = 18; }
			switch (gunId) {
				case 'blaster':
					ctx.fillStyle = col;
					fRR(ctx, -55, -4, 110, 8, 2);
					ctx.fillStyle = acc;
					fRR(ctx, -20, -12, 40, 24, 4);
					ctx.fillStyle = col;
					fRR(ctx, -8, 10, 16, 28, 3);
					fRR(ctx, 38, -8, 18, 16, 3);
					ctx.fillStyle = '#fff';
					ctx.beginPath();
					ctx.arc(0, 0, 5, 0, Math.PI * 2);
					ctx.fill();
					break;
				case 'chrome':
					ctx.fillStyle = acc;
					fRR(ctx, -45, -5, 90, 10, 2);
					ctx.fillStyle = col;
					fRR(ctx, -18, -14, 36, 28, 5);
					fRR(ctx, -10, 10, 20, 30, 3);
					ctx.fillStyle = '#fff';
					fRR(ctx, 40, -3, 8, 6, 2);
					break;
				case 'dusty':
					ctx.fillStyle = col;
					fRR(ctx, -40, -5, 85, 10, 2);
					ctx.fillStyle = acc;
					fRR(ctx, -12, -13, 24, 26, 6);
					ctx.fillStyle = col;
					fRR(ctx, -10, 10, 18, 32, 3);
					ctx.fillStyle = 'rgba(0,0,0,0.2)';
					fRR(ctx, -30, -3, 20, 6, 1);
					break;
