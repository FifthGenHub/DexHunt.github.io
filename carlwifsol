						txt('+3 $HUNT for sharing!', W / 2, btnY - H * 0.01, '9px "Share Tech Mono"', C.gold, ra); }
					const na = 0.3 + 0.4 * Math.abs(Math.sin(now * 3));
					txt('Tap elsewhere for next duel', W / 2, H * 0.96, '10px "Share Tech Mono"', C.dim, na);
