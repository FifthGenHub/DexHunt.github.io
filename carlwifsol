<!DOCTYPE html>

<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
	<meta name="apple-mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
	<meta name="theme-color" content="#0a0a14">
	<title>DexHunt: Reflex Showdown</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&display=swap" rel="stylesheet">
	<style>
		*,
		*::before,
		*::after {
			margin: 0;
			padding: 0;
			box-sizing: border-box
		}

		html,
		body {
			width: 100%;
			height: 100%;
			overflow: hidden;
			background: #0a0a14;
			touch-action: none;
			-webkit-touch-callout: none;
			-webkit-user-select: none;
			user-select: none;
			-webkit-tap-highlight-color: transparent
		}

		#gameCanvas {
			display: block;
			width: 100vw;
			height: 100vh;
			position: fixed;
			top: 0;
			left: 0;
			z-index: 1
		}

		#hud {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			z-index: 10;
			pointer-events: none;
			padding: env(safe-area-inset-top, 12px) 16px 0 16px
		}

		#hud>* {
			pointer-events: auto
		}

		#hudBar {
			display: flex;
			justify-content: space-between;
			align-items: center;
			background: rgba(10, 10, 20, 0.88);
			border: 1px solid rgba(0, 255, 255, 0.15);
			border-radius: 10px;
			padding: 6px 12px;
			margin-top: 6px;
			font-family: 'Share Tech Mono', monospace;
			font-size: 10px;
			color: #d4a800;
			backdrop-filter: blur(8px);
			-webkit-backdrop-filter: blur(8px);
			opacity: 0;
			transition: opacity 0.4s
		}

		#hudBar.visible {
			opacity: 1
		}

		.hbtn {
			background: rgba(0, 255, 255, 0.08);
			border: 1px solid rgba(0, 255, 255, 0.25);
			color: #00ffff;
			font-family: 'Share Tech Mono', monospace;
			font-size: 10px;
			padding: 5px 9px;
			border-radius: 6px;
			cursor: pointer;
			transition: all 0.2s;
			margin-left: 3px
		}

		.hbtn.lb-btn {
			border-color: rgba(0, 255, 136, 0.4);
			color: #00ff88
		}

		.hbtn:active {
			background: rgba(0, 255, 255, 0.25);
			transform: scale(0.95)
		}

		.hbtn.muted {
			border-color: rgba(255, 140, 0, 0.4);
			color: #ff8c00
		}

		.hbtn.shop-btn {
			border-color: rgba(255, 215, 0, 0.4);
			color: #ffd700
		}

		.hbtn.stop-btn {
			border-color: rgba(255, 38, 38, 0.4);
			color: #ff2626
		}

		.side-panel {
			position: fixed;
			top: 0;
			left: -260px;
			width: 250px;
			height: 100%;
			background: rgba(8, 8, 18, 0.96);
			border-right: 2px solid rgba(0, 255, 255, 0.2);
			z-index: 50;
			transition: left 0.28s cubic-bezier(0.4, 0, 0.2, 1);
			padding: env(safe-area-inset-top, 16px) 0 20px 0;
			overflow-y: auto;
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
			font-family: 'Share Tech Mono', monospace
		}

		.side-panel.open {
			left: 0
		}

		.sp-overlay {
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background: rgba(0, 0, 0, 0.5);
			z-index: 45;
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.25s
		}

		.sp-overlay.open {
			opacity: 1;
			pointer-events: auto
		}

		.sp-header {
			color: #00ffff;
			font-family: 'Orbitron', sans-serif;
			font-size: 18px;
			font-weight: 900;
			text-align: center;
			padding: 20px 16px 12px;
			text-shadow: 0 0 15px rgba(0, 255, 255, 0.5);
			letter-spacing: 2px
		}

		.sp-btn {
			display: block;
			width: calc(100% - 24px);
			margin: 4px 12px;
			padding: 12px 16px;
			background: rgba(0, 255, 255, 0.04);
			border: 1px solid rgba(0, 255, 255, 0.12);
			border-radius: 8px;
			color: #ccc;
			font-family: 'Share Tech Mono', monospace;
			font-size: 14px;
			text-align: left;
			cursor: pointer;
			transition: all 0.15s
		}

		.sp-btn:active {
			background: rgba(0, 255, 255, 0.15);
			transform: scale(0.97)
		}

		.sp-btn.sp-small {
			font-size: 12px;
			padding: 8px 16px;
			color: #888
		}

		.sp-divider {
			height: 1px;
			margin: 12px 20px;
			background: rgba(0, 255, 255, 0.1)
		}

		.sp-footer {
			color: rgba(0, 255, 255, 0.25);
			font-size: 9px;
			text-align: center;
			padding: 16px;
			position: absolute;
			bottom: 10px;
			width: 100%
		}

		.ticker-bar {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			height: 0;
			background: rgba(8, 8, 18, 0.88);
			border-bottom: 1px solid rgba(0, 255, 255, 0.1);
			z-index: 8;
			overflow: hidden;
			font-family: 'Share Tech Mono', monospace;
			font-size: 9px;
			color: rgba(0, 255, 255, 0.6);
			white-space: nowrap;
			transition: height 0.2s;
			pointer-events: none
		}

		.ticker-bar.active {
			height: 20px;
			padding: 3px 0
		}

		.ticker-inner {
			display: inline-block;
			animation: tickerScroll 30s linear infinite
		}

		@keyframes tickerScroll {
			0% {
				transform: translateX(100vw)
			}

			100% {
				transform: translateX(-100%)
			}
		}

		#toast {
			position: fixed;
			bottom: 60px;
			left: 50%;
			transform: translateX(-50%);
			background: rgba(10, 10, 20, 0.92);
			border: 1px solid rgba(212, 168, 0, 0.4);
			color: #d4a800;
			font-family: 'Share Tech Mono', monospace;
			font-size: 12px;
			padding: 8px 20px;
			border-radius: 8px;
			z-index: 20;
			opacity: 0;
			transition: opacity 0.3s;
			pointer-events: none;
			backdrop-filter: blur(6px);
			-webkit-backdrop-filter: blur(6px);
			white-space: nowrap
		}

		#toast.show {
			opacity: 1
		}
	</style>
</head>

<body>
