		function handleTooSoon() {
			G.state = State.TOO_SOON;
			G.resultText = 'TOO SOON!';
			G.resultSub = 'Wait for DRAW! cowboy...';
			G.resultColor = C.orange;
			G.resultColorRgb = C.orangeRgb;
			G.isWin = false;
			G.resultTime = performance.now() / 1000;
			G.screenFlashA = 0.25;
			G.winStreak = 0;
			G.comboCount = 0;
			dropHeat(HEAT_DECAY_LOSS);
			spawnP(W / 2, H * 0.4, 10, C.orangeRgb);
			sfxTooSoon();
		}

		function handleDrawTap() {
			const tapTime = performance.now() / 1000;
			const ms = Math.round((tapTime - G.drawSignalTime) * 1000);
			G.reactionMs = ms;
			G.totalDuels++;
			G.screenFlashA = 0.5;
			G.screenShakeT = 0.15;
			sfxGunshot();
			triggerRecoil();
			if (ms <= WIN_THRESHOLD) processWin(ms);
			else processLoss(ms);
			G.resultTime = performance.now() / 1000;
			G.state = State.RESULT;
			updateHud();
		}

		function processWin(ms) {
			G.isWin = true;
			G.winStreak++;
			G.lossStreak = 0;
			G.totalWins++;
			if (G.winStreak > G.bestStreak) G.bestStreak = G.winStreak;
			const isNew = (G.bestDrawMs === 0 || ms < G.bestDrawMs);
			if (isNew) G.bestDrawMs = ms;
			G.isNewBest = isNew;

			// Heat
			addHeat(HEAT_GAIN_WIN);
			if (ms <= GOOD_THRESHOLD) addHeat(HEAT_GAIN_FAST);

			// Reward with heat multiplier
			const baseReward = 5 + Math.floor(Math.max(0, 600 - ms) / 25) + Math.min(G.winStreak * 2, 30);
			const reward = Math.round(baseReward * getHeatMultiplier());
			G.dexBalance += reward;
			G.lastReward = reward;

			if (ms <= FAST_THRESHOLD) {
				G.resultText = 'LIGHTNING!';
				G.resultColor = C.cyan;
				G.resultColorRgb = C.cyanRgb;
				G.comboCount++;
				addHeat(HEAT_GAIN_COMBO);
				G.comboText = G.comboCount > 1 ? 'COMBO x' + G.comboCount + '!' : 'FAST!';
				G.comboAlpha = 1;
				spawnP(W / 2, H * 0.38, 40, C.cyanRgb, { speed: [120, 350] });
				spawnP(W / 2, H * 0.38, 15, C.whiteRgb, { speed: [60, 200], size: [2, 5] });
				G.screenShakeT = 0.25;
			} else if (ms <= GOOD_THRESHOLD) {
				G.resultText = 'QUICK DRAW!';
				G.resultColor = C.lime;
				G.resultColorRgb = C.limeRgb;
				G.comboCount++;
				addHeat(HEAT_GAIN_COMBO);
				G.comboText = G.comboCount > 1 ? 'COMBO x' + G.comboCount + '!' : 'NICE!';
				G.comboAlpha = 1;
				spawnP(W / 2, H * 0.38, 30, C.limeRgb, { speed: [100, 300] });
				G.screenShakeT = 0.18;
			} else {
				G.resultText = 'GOTCHA!';
				G.resultColor = C.gold;
				G.resultColorRgb = C.goldRgb;
				G.comboCount = 0;
				spawnP(W / 2, H * 0.38, 18, C.goldRgb);
			}
			if (G.winStreak === STREAK_NICE || G.winStreak === STREAK_HOT || G.winStreak === STREAK_LEGEND) { spawnP(W / 2, H * 0.45, 20, C.goldRgb, { speed: [60, 200], life: [0.8, 1.5] });
				sfxStreak(); }
			sfxWin();
			let sub = ms + 'ms';
			if (isNew) sub += ' \u2014 NEW BEST!';
			if (G.winStreak >= STREAK_NICE) sub += ' | ' + getStreakLabel();
			const heatMult = getHeatMultiplier();
			sub += ' | +' + reward + ' $HUNT';
			if (heatMult > 1.1) sub += ' (' + heatMult.toFixed(1) + 'x\uD83D\uDD25)';
			G.resultSub = sub;
			saveGame();
			showToast('+' + reward + ' $HUNT' + (isNew ? ' \u2014 NEW BEST!' : ''));
			if (isNew) setTimeout(() => generateShareCard(), 50);
		}

		function processLoss(ms) {
			G.isWin = false;
			G.resultText = 'TOO SLOW!';
			G.resultSub = ms + 'ms \u2014 Need under ' + WIN_THRESHOLD + 'ms';
			G.resultColor = C.red;
			G.resultColorRgb = C.redRgb;
			G.winStreak = 0;
			G.lossStreak++;
			G.comboCount = 0;
			G.comboAlpha = 0;
			dropHeat(HEAT_DECAY_LOSS);
			spawnP(W / 2, H * 0.38, 8, C.redRgb, { speed: [40, 120], size: [2, 5] });
			sfxLose();
			saveGame();
		}

		function getStreakLabel() { if (G.winStreak >= STREAK_LEGEND) return 'LEGENDARY!'; if (G.winStreak >= STREAK_HOT) return 'Hot Shot!'; if (G.winStreak >= STREAK_NICE) return 'Nice!'; if (G.winStreak >= 1) return 'Streak: ' + G.winStreak; return ''; }

