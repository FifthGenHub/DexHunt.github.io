		function handlePanelTap(tx, ty) {
			if (ty < H * 0.06) { G.state = State.MENU;
				sfxSelect(); return; }
			// Scroll: tap top half = scroll up, bottom half = scroll down
			if (ty < H * 0.5) G.panelScroll = Math.max(0, G.panelScroll - 1);
			else G.panelScroll++;
		}

