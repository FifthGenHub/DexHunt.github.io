				{ name: 'RustBucket', ms: 312, streak: 3, color: C.dim },
				{ name: 'SlowPoke', ms: 445, streak: 1, color: C.dim },
			];
			// Merge & sort
			const all = [...entries, ...rivals].sort((a, b) => {
				const am = typeof a.ms === 'number' ? a.ms : 9999;
				const bm = typeof b.ms === 'number' ? b.ms : 9999;
				return am - bm;
			});
			txt('Season 1 \u2014 Neon Frontier', '' + W / 2, H * 0.07, '10px "Share Tech Mono"', C.magenta, 0.6);
