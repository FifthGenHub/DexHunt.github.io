		function neon(t, x, y, f, c, g, gs, a) { if (a < 0.01) return;
			ctx.save();
			ctx.globalAlpha = a;
			ctx.font = f;
			ctx.textAlign = 'center';
			ctx.textBaseline = 'middle'; if (gs > 0) { ctx.shadowColor = g;
				ctx.shadowBlur = gs * 2;
				ctx.fillStyle = g;
				ctx.fillText(t, x, y);
				ctx.shadowBlur = gs;
				ctx.fillText(t, x, y); } ctx.shadowBlur = gs * 0.5;
			ctx.shadowColor = g;
			ctx.fillStyle = c;
			ctx.fillText(t, x, y);
			ctx.restore(); }

		function txt(t, x, y, f, c, a) { if (a < 0.01) return;
			ctx.save();
			ctx.globalAlpha = a;
			ctx.font = f;
			ctx.textAlign = 'center';
			ctx.textBaseline = 'middle';
			ctx.fillStyle = c;
			ctx.fillText(t, x, y);
			ctx.restore(); }

		function txtL(t, x, y, f, c, a) { if (a < 0.01) return;
			ctx.save();
			ctx.globalAlpha = a;
			ctx.font = f;
			ctx.textAlign = 'left';
			ctx.textBaseline = 'middle';
			ctx.fillStyle = c;
			ctx.fillText(t, x, y);
			ctx.restore(); }

		function triggerRecoil() { G.recoilY = 0;
			G.recoilVel = -350;
			G.recoilRot = 0;
			G.recoilRotVel = -6;
			G.recoilActive = true; }

		function updateRecoil(dt) { if (!G.recoilActive) return; const k = 800,
				d = 12;
			G.recoilVel += (-k * G.recoilY - d * G.recoilVel) * dt;
			G.recoilY += G.recoilVel * dt;
			G.recoilRotVel += (-k * 0.8 * G.recoilRot - d * 1.5 * G.recoilRotVel) * dt;
			G.recoilRot += G.recoilRotVel * dt; if (Math.abs(G.recoilY) < 0.3 && Math.abs(G.recoilVel) < 5 && Math.abs(G.recoilRot) < 0.005 && Math.abs(G.recoilRotVel) < 0.1) { G.recoilY = 0;
				G.recoilVel = 0;
				G.recoilRot = 0;
				G.recoilRotVel = 0;
				G.recoilActive = false; } }

		// ================================================================
		// 12. HEAT METER
		//     Visual feedback bar showing "momentum". Rises on wins/combos,
		//     decays on idle/losses. At 100%, rewards get a 2x multiplier.
		//     Rendered as a vertical bar on the left edge of the screen.
		// ================================================================
		function addHeat(amount) {
			G.heat = Math.min(HEAT_MAX, G.heat + amount);
			if (G.heat > G.heatPeak) G.heatPeak = G.heat;
		}

		function decayHeat(dt) {
			if (G.heat > 0) G.heat = Math.max(0, G.heat - HEAT_DECAY_RATE * dt);
		}

		function dropHeat(amount) {
			G.heat = Math.max(0, G.heat - amount);
		}

		function getHeatMultiplier() {
			// At max heat, 2x rewards. Scales linearly.
			return 1 + (G.heat / HEAT_MAX);
		}

		function getHeatColor() {
			// Blue -> Cyan -> Green -> Yellow -> Orange -> Red as heat rises
			const t = G.heat / HEAT_MAX;
			if (t < 0.25) return C.cyan;
			if (t < 0.50) return C.lime;
			if (t < 0.75) return C.orange;
			return C.red;
		}

		function drawHeatMeter() {
			if (G.state === State.MENU || G.state === State.SHOP) return;
			const barW = 6;
			const barH = H * 0.5;
			const barX = 10;
			const barY = H * 0.25;
			const fill = G.heat / HEAT_MAX;

			// Background track
			ctx.fillStyle = 'rgba(40,40,60,0.4)';
			fRR(ctx, barX, barY, barW, barH, 3);

			// Filled portion (from bottom up)
			if (fill > 0.01) {
				const fillH = barH * fill;
				const hColor = getHeatColor();
				ctx.save();
				ctx.shadowColor = hColor;
				ctx.shadowBlur = 8;
				ctx.fillStyle = hColor;
				fRR(ctx, barX, barY + barH - fillH, barW, fillH, 3);
				ctx.restore();
			}

			// Label
			if (G.heat > 5) {
				const pct = Math.round(G.heat);
				txt(pct + '%', barX + barW / 2, barY - 10, '8px "Share Tech Mono"', getHeatColor(), 0.6);
			}

			// Max heat indicator
			if (G.heat >= HEAT_MAX * 0.95) {
				const pulse = 0.6 + 0.4 * Math.abs(Math.sin(performance.now() / 1000 * 4));
				txt('MAX', barX + barW / 2, barY - 22, 'bold 8px "Orbitron"', C.red, pulse);
			}

			// Multiplier display
			if (G.heat > 10) {
				const mult = getHeatMultiplier().toFixed(1);
				txt(mult + 'x', barX + barW / 2, barY + barH + 14, '8px "Share Tech Mono"', getHeatColor(), 0.5);
			}
		}

