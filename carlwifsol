		function onTap(e) {
			e.preventDefault();
			ensureAudio();
			let tx = 0,
				ty = 0;
			if (e.touches && e.touches.length > 0) { tx = e.touches[0].clientX;
				ty = e.touches[0].clientY; } else { tx = e.clientX;
				ty = e.clientY; }
			switch (G.state) {
				case State.MENU:
					if (ty > H * 0.82) { if (tx < W / 2) G.gunSelectIdx = (G.gunSelectIdx - 1 + GUNS.length) % GUNS.length;
						else G.gunSelectIdx = (G.gunSelectIdx + 1) % GUNS.length;
						G.equippedGun = GUNS[G.gunSelectIdx].id;
						sfxSelect(); return; }
					G.currentQuote = G.quotes[Math.floor(Math.random() * G.quotes.length)];
					startCountdown();
					break;
				case State.COUNTDOWN:
					break;
				case State.WAITING:
					handleTooSoon();
					break;
				case State.DRAW:
					handleDrawTap();
					break;
				case State.RESULT:
					if (G._shareBtnBounds) { const b = G._shareBtnBounds; if (tx >= b.x && tx <= b.x + b.w && ty >= b.y && ty <= b.y + b.h) { doShare(); return; } }
					if (G._challengeBtnBounds) { const b = G._challengeBtnBounds; if (tx >= b.x && tx <= b.x + b.w && ty >= b.y && ty <= b.y + b.h) { doChallenge(); return; } }
					if (G.shareCardUrl && G._cardBounds) { const b = G._cardBounds; if (tx >= b.x && tx <= b.x + b.w && ty >= b.y && ty <= b.y + b.h) { downloadShareCard(); return; } }
					startCountdown();
					break;
				case State.TOO_SOON:
					startCountdown();
					break;
				case State.SHOP:
					handleShopTap(tx, ty);
					break;
				case State.LEADERBOARD:
				case State.TOKENOMICS:
				case State.ROADMAP:
					handlePanelTap(tx, ty);
					break;
			}
		}
		canvas.addEventListener('touchstart', onTap, { passive: false });
		canvas.addEventListener('mousedown', onTap);

		function handleShopTap(tx, ty) {
			if (ty < H * 0.08) { G.state = State.MENU;
				sfxSelect(); return; }
			if (ty >= H * 0.08 && ty <= H * 0.14) { if (tx < W / 2) { G.shopTab = 'guns';
					G.shopSelectedIdx = 0; } else { G.shopTab = 'reticles';
					G.shopSelectedIdx = 0; } sfxSelect(); return; }
			if (ty >= H * 0.16 && ty <= H * 0.92) {
				const items = getShopItems(),
					itemH = H * 0.088;
				const idx = Math.floor((ty - H * 0.16) / itemH);
				if (idx >= 0 && idx < items.length) {
					G.shopSelectedIdx = idx;
					const item = items[idx];
					const owned = getOwnedList(),
						equipped = getEquipped();
					if (owned.includes(item.id) || item.cost === 0) { if (equipped !== item.id) shopEquip(item); } else shopBuy(item);
				}
				return;
			}
		}
