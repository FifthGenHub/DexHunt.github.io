		// ================================================================
		// 22. BOOT
		// ================================================================
		function wireHudBtn(id, fn) { const el = document.getElementById(id); if (!el) return;
			el.addEventListener('touchstart', function(e) { e.stopPropagation();
				e.preventDefault();
				ensureAudio();
				fn(); }, { passive: false });
			el.addEventListener('click', function(e) { e.stopPropagation();
				ensureAudio();
				fn(); }); }
		wireHudBtn('stopBtn', stopDueling);
		wireHudBtn('menuBtn', toggleSidePanel);
		const sidePanel = document.getElementById('sidePanel');
		const spOverlay = document.getElementById('sidePanelOverlay');

		function toggleSidePanel() { sidePanel.classList.toggle('open');
			spOverlay.classList.toggle('open'); }

		function closeSidePanel() { sidePanel.classList.remove('open');
			spOverlay.classList.remove('open'); }
		spOverlay.addEventListener('click', closeSidePanel);
		spOverlay.addEventListener('touchstart', (e) => { e.preventDefault();
			closeSidePanel(); }, { passive: false });
		document.querySelectorAll('.sp-btn').forEach(btn => {
			btn.addEventListener('click', () => {
				const p = btn.dataset.panel;
				closeSidePanel();
				if (p === 'shop') openShop();
				else if (p === 'lb') openPanel(State.LEADERBOARD);
				else if (p === 'token') openPanel(State.TOKENOMICS);
				else if (p === 'road') openPanel(State.ROADMAP);
				else if (p === 'mute') toggleMute();
				else if (p === 'wallet') toggleWallet();
			});
		});
		let swipeStartX = 0,
			swiping = false;
		document.addEventListener('touchstart', (e) => { const t = e.touches[0]; if (t.clientX < 30 && !sidePanel.classList.contains('open')) { swipeStartX = t.clientX;
				swiping = true; } }, { passive: true });
		document.addEventListener('touchmove', (e) => { if (!swiping) return; const dx = e.touches[0].clientX - swipeStartX; if (dx > 50) { swiping = false;
				toggleSidePanel(); } }, { passive: true });
		document.addEventListener('touchend', () => { swiping = false; }, { passive: true });

		function updateTicker() {
			const bar = document.getElementById('ticker');
			const names = ['NeonViper', 'DesertFox', 'GhostHand', 'QuickSilva', 'DustDevil', 'ShadowDraw', 'IronSight', 'CyberColt', 'PixelPete', 'LaserLou', 'VoltViper', 'ByteBandit', 'NeonNomad', 'GridGhost', 'PulseRider', 'HexHawk', 'CodeCowboy', 'DataDrifter', 'FluxFang', 'WireWolf', 'RustRanger', 'BitBullet', 'CryptoKid', 'MetalMike', 'ChainLink'];
			const entries = names.map(n => n + ': ' + (120 + Math.floor(Math.random() * 250)) + 'ms').join('  \u2022  ');
			bar.innerHTML = '<div class="ticker-inner">\uD83C\uDFC6 TOP 25 LIVE  \u2022  ' + entries + '  \u2022  Play now at DexHunt.io</div>';
			bar.classList.add('active');
			setTimeout(updateTicker, 30000);
		}
		updateTicker();
		showHud(true);
		showStopBtn(false);
		updateHud();
		requestAnimationFrame(gameLoop);
