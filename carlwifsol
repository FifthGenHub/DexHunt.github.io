				txtL(e.name, W * 0.20, y, 'bold 11px "Share Tech Mono"', nc, isYou ? 1 : 0.7);
				txt(e.ms + 'ms', W * 0.68, y, 'bold 11px "Orbitron"', isYou ? C.gold : '#fff', isYou ? 1 : 0.6);
