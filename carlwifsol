		// ================================================================
		// 18. MAIN LOOP
		// ================================================================
		let lastTime = performance.now() / 1000;

		function gameLoop(ts) {
			requestAnimationFrame(gameLoop);
			const now = ts / 1000;
			let dt = now - lastTime;
			lastTime = now;
			if (dt > 0.1) dt = 0.1;
			update(dt, now);
			render(now);
		}

		// ================================================================
		// 19. UPDATE
		// ================================================================
		function update(dt, now) {
			updateParticles(dt);
			updateRecoil(dt);
			G.titlePulse += dt * 2.5;
			if (G.titlePulse > Math.PI * 2) G.titlePulse -= Math.PI * 2;
			if (G.screenFlashA > 0) G.screenFlashA = Math.max(0, G.screenFlashA - dt * 4);
			if (G.comboAlpha > 0) G.comboAlpha = Math.max(0, G.comboAlpha - dt * 1.2);
			if (G.screenShakeT > 0) { G.screenShakeT -= dt; const i = G.screenShakeT * 30;
				G.screenShakeX = (Math.random() - 0.5) * i;
				G.screenShakeY = (Math.random() - 0.5) * i; } else { G.screenShakeX = 0;
				G.screenShakeY = 0; }

			// Heat decay during non-active states
			if (G.state === State.WAITING || G.state === State.COUNTDOWN) decayHeat(dt * 0.3); // Slow decay during play
			else if (G.state === State.MENU || G.state === State.LEADERBOARD || G.state === State.TOKENOMICS || G.state === State.ROADMAP) decayHeat(dt); // Normal decay on menu

			// Smooth heat peak animation
			if (G.heatPeak > G.heat) G.heatPeak = Math.max(G.heat, G.heatPeak - dt * 40);

			switch (G.state) {
				case State.COUNTDOWN: { const r = COUNTDOWN_SECS - (now - G.countdownStart); if (r <= 0) { G.state = State.WAITING;
						G.waitStart = now;
						G.waitDuration = DRAW_MIN_DELAY + Math.random() * (DRAW_MAX_DELAY - DRAW_MIN_DELAY); } else { G.countdownVal = Math.ceil(r); if (G.countdownVal !== G.prevCountdownVal) { G.prevCountdownVal = G.countdownVal;
							sfxTick(); } } break; }
				case State.WAITING: { if (now - G.waitStart >= G.waitDuration) { G.state = State.DRAW;
						G.drawSignalTime = performance.now() / 1000;
						G.drawFlashA = 1.0;
						spawnP(W / 2, H * 0.35, 15, C.magRgb, { speed: [60, 180], life: [0.4, 0.9] });
						sfxDraw(); } break; }
				case State.DRAW: { const e = now - G.drawSignalTime; if (G.drawFlashA > 0.5) G.drawFlashA -= dt * 2.5;
					else G.drawFlashA = 0.55 + 0.2 * Math.sin(e * 7); break; }
				case State.RESULT: { if (!G.isNewBest && now - G.resultTime >= RESULT_DISPLAY_SEC && G.autoLoop) startCountdown(); break; }
				case State.TOO_SOON: { if (now - G.resultTime >= TOO_SOON_PENALTY && G.autoLoop) startCountdown(); break; }
			}
		}

		// ================================================================
		// 20. RENDER
		// ================================================================
		function render(now) {
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.save();
			if (G.screenShakeX || G.screenShakeY) ctx.translate(G.screenShakeX, G.screenShakeY);
			ctx.fillStyle = C.bg;
			ctx.fillRect(-10, -10, W + 20, H + 20);
			for (const s of G.stars) { const tw = 0.5 + 0.5 * Math.sin(now * s.ts + s.to);
				ctx.beginPath();
				ctx.arc(s.x * W, s.y * H, s.size, 0, Math.PI * 2);
				ctx.fillStyle = `rgba(200,200,240,${s.alpha*tw})`;
				ctx.fill(); }
			switch (G.state) {
				case State.MENU:
					renderMenu(now);
					break;
				case State.COUNTDOWN:
					renderCountdown(now);
					break;
				case State.WAITING:
					renderWaiting(now);
					break;
				case State.DRAW:
					renderDraw(now);
					break;
				case State.RESULT:
					renderResult(now);
					break;
				case State.TOO_SOON:
					renderTooSoon(now);
					break;
				case State.SHOP:
					renderShop(now);
					break;
				case State.LEADERBOARD:
					renderLeaderboard(now);
					break;
				case State.TOKENOMICS:
					renderTokenomics(now);
					break;
				case State.ROADMAP:
					renderRoadmap(now);
					break;
			}
			drawParticles();
			// Gun sprite during active states
			if ([State.DRAW, State.RESULT, State.TOO_SOON].includes(G.state)) { ctx.save();
				ctx.translate(W / 2, H * 0.82 + G.recoilY);
				ctx.rotate(G.recoilRot);
				drawProceduralGun(ctx, 0, 0, 2.2, G.equippedGun, 0.9, G.state === State.DRAW);
				ctx.restore(); } else if (G.state === State.COUNTDOWN || G.state === State.WAITING) { drawProceduralGun(ctx, W / 2, H * 0.85, 1.5, G.equippedGun, 0.2, false); }
			// Reticle during DRAW
			if (G.state === State.DRAW) drawReticle(ctx, W / 2, H * 0.35, G.equippedReticle, 20, 0.8 + 0.2 * Math.sin(now * 5));
			// Heat meter (all active game states)
			drawHeatMeter();
			if (G.screenFlashA > 0.01) { ctx.fillStyle = `rgba(255,255,255,${G.screenFlashA})`;
				ctx.fillRect(-10, -10, W + 20, H + 20); }
			if (G.comboAlpha > 0.03 && G.comboText) neon(G.comboText, W / 2, H * 0.22, 'bold 28px "Orbitron"', C.magenta, C.magenta, 12, G.comboAlpha);
