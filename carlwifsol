				rowH = H * 0.055;
			for (let i = 0; i < all.length && i < 10; i++) {
				const e = all[i],
					y = startY + i * rowH;
				const rank = i + 1;
				const isYou = e.name === 'YOU';
				if (isYou) { ctx.fillStyle = 'rgba(0,255,255,0.08)';
					fRR(ctx, W * 0.04, y - rowH * 0.35, W * 0.92, rowH - 4, 6); }
				const rc = rank <= 1 ? C.gold : rank <= 3 ? C.cyan : C.dim;
				txt('#' + rank, W * 0.10, y, 'bold 12px "Orbitron"', rc, isYou ? 1 : 0.7);
