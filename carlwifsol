			// Simulated rivals based on skill tier
			const rivals = [
				{ name: 'NeonViper', ms: 142, streak: 12, color: C.dim },
				{ name: 'DesertFox', ms: 178, streak: 8, color: C.dim },
				{ name: 'GhostHand', ms: 195, streak: 6, color: C.dim },
